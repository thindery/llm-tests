# ============================================================================
# AGENTTRACE BACKEND - Railway Environment Variables
# ============================================================================
# Copy these values into Railway dashboard or use: railway variables --set KEY=VALUE
# ============================================================================

# =============================================================================
# REQUIRED: Database (Railway provides this automatically when you add Postgres)
# =============================================================================
# Railway will auto-generate this when you provision a PostgreSQL database
# Format: postgresql+asyncpg://user:pass@host/database
DATABASE_URL=postgresql+asyncpg://username:password@postgres.railway.internal:5432/railway

# =============================================================================
# REQUIRED: Security (Generate strong secrets)
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OPTIONAL: R2 Storage for Session Replays (Cloudflare R2)
# If not configured, app will use local storage as fallback
# =============================================================================
R2_BUCKET_NAME=agenttrace-sessions
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# Get endpoint from Cloudflare R2 dashboard
# Format: https://[account-id].r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Public CDN URL for sessions (optional)
R2_PUBLIC_URL_BASE=https://sessions.yourdomain.com

# =============================================================================
# OPTIONAL: Local Storage Fallback
# =============================================================================
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=/tmp/agenttrace/sessions

# =============================================================================
# OPTIONAL: App Configuration
# =============================================================================
APP_NAME=AgentTrace
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production

# CORS origins - comma-separated, no spaces
# For production: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# OPTIONAL: Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# OPTIONAL: Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# OPTIONAL: Session Settings
# =============================================================================
SESSION_MAX_SIZE_MB=50
SESSION_RETENTION_DAYS=30

# =============================================================================
# OPTIONAL: WebSocket Settings
# =============================================================================
WS_HEARTBEAT_INTERVAL=30
WS_PING_TIMEOUT=60